      "fields": Array [
        "system.cpu.load_average.1m",
        "system.load.1",
      ],
      "kind": "metric",
      "name": "load_1m",
      "unit": "load",
    },
    Object {
      "kind": "last_seen",
      "name": "last_seen",
    },
  ],
  "identity": Object {
    "entityIdEvaluation": "host_id_present = TO_STRING(host.id) IS NOT NULL AND TO_STRING(host.id) != \\"\\",
 host_name_present = TO_STRING(host.name) IS NOT NULL AND TO_STRING(host.name) != \\"\\",
 host_hostname_present = TO_STRING(host.hostname) IS NOT NULL AND TO_STRING(host.hostname) != \\"\\",
 host_id_present_or_null = CASE(host_id_present, TO_STRING(host.id)),
 host_name_present_or_null = CASE(host_name_present, TO_STRING(host.name)),
 host_hostname_present_or_null = CASE(host_hostname_present, TO_STRING(host.hostname)),
 entity.id = CONCAT(\\"host:\\", COALESCE(host_id_present_or_null, host_name_present_or_null, host_hostname_present_or_null))",
    "fields": Array [
      "host.id",
      "host.name",
      "host.hostname",
    ],
    "kind": "ranking",
    "presenceFilter": "(\`host.id\` IS NOT NULL OR \`host.name\` IS NOT NULL OR \`host.hostname\` IS NOT NULL)",
  },
}
`;

exports[`generator host list query for source 0 (metrics-hostmetricsreceiver.otel-default) under TS and FROM: FROM 1`] = `
Object {
  "esql": "SET unmapped_fields=\\"nullify\\";
FROM metrics-hostmetricsreceiver.otel-default
| WHERE @timestamp >= ?from AND @timestamp < ?to
    AND (state == \\"idle\\")
    AND (\`host.id\` IS NOT NULL OR \`host.name\` IS NOT NULL OR \`host.hostname\` IS NOT NULL)
    AND (\`system.cpu.utilization\` IS NOT NULL)
| STATS \`cpu_pct\` = AVG(\`system.cpu.utilization\`),
    \`host.os.name\` = LAST(\`host.os.name\`, @timestamp) WHERE \`host.os.name\` IS NOT NULL,
    \`host.os.platform\` = LAST(\`host.os.platform\`, @timestamp) WHERE \`host.os.platform\` IS NOT NULL,
    \`host.architecture\` = LAST(\`host.architecture\`, @timestamp) WHERE \`host.architecture\` IS NOT NULL,
    \`last_seen\` = MAX(@timestamp)
    BY \`host.id\`, \`host.name\`, \`host.hostname\`
| EVAL \`cpu_pct\` = \`cpu_pct\` * -1.0 + 1.0
| EVAL host_id_present = TO_STRING(host.id) IS NOT NULL AND TO_STRING(host.id) != \\"\\",
 host_name_present = TO_STRING(host.name) IS NOT NULL AND TO_STRING(host.name) != \\"\\",
 host_hostname_present = TO_STRING(host.hostname) IS NOT NULL AND TO_STRING(host.hostname) != \\"\\",
 host_id_present_or_null = CASE(host_id_present, TO_STRING(host.id)),
 host_name_present_or_null = CASE(host_name_present, TO_STRING(host.name)),
 host_hostname_present_or_null = CASE(host_hostname_present, TO_STRING(host.hostname)),
 entity.id = CONCAT(\\"host:\\", COALESCE(host_id_present_or_null, host_name_present_or_null, host_hostname_present_or_null))
| KEEP \`entity.id\`, \`host.id\`, \`host.name\`, \`host.hostname\`, \`host.os.name\`, \`host.os.platform\`, \`host.architecture\`, \`cpu_pct\`, \`last_seen\`
| SORT \`last_seen\` DESC NULLS LAST
| LIMIT 10000",
  "params": Array [
    Object {
      "from": "2026-09-16T08:30:00.000Z",
    },
    Object {
      "to": "2026-09-16T08:45:00.000Z",
    },
  ],
}
`;

