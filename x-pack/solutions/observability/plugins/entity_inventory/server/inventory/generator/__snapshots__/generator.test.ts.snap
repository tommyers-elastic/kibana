// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`generator host count query 1`] = `
Object {
  "esql": "SET unmapped_fields=\\"nullify\\";
FROM metrics-hostmetricsreceiver.otel-default, metrics-system.* METADATA _index
| WHERE @timestamp >= ?from AND @timestamp < ?to
    AND (\`host.id\` IS NOT NULL OR \`host.name\` IS NOT NULL OR \`host.hostname\` IS NOT NULL)
    AND (((_index LIKE \\"metrics-hostmetricsreceiver.otel-default\\" OR _index LIKE \\".ds-metrics-hostmetricsreceiver.otel-default-*\\") AND (state == \\"idle\\") AND (\`system.cpu.utilization\` IS NOT NULL))
      OR ((_index LIKE \\"metrics-hostmetricsreceiver.otel-default\\" OR _index LIKE \\".ds-metrics-hostmetricsreceiver.otel-default-*\\") AND (\`system.cpu.load_average.1m\` IS NOT NULL))
      OR ((_index LIKE \\"metrics-system.*\\" OR _index LIKE \\".ds-metrics-system.*-*\\") AND (metricset.name IN (\\"cpu\\", \\"load\\")) AND (\`system.cpu.total.norm.pct\` IS NOT NULL OR \`system.load.1\` IS NOT NULL)))
| STATS BY \`host.id\`, \`host.name\`, \`host.hostname\`
| STATS \`count\` = COUNT(*)",
  "params": Array [
    Object {
      "from": "2026-09-16T08:30:00.000Z",
    },
    Object {
      "to": "2026-09-16T08:45:00.000Z",
    },
  ],
}
`;

