exports[`generator k8s.pod list query for source 2 (metrics-kubernetes.state_pod-*) under TS and FROM: TS 1`] = `
Object {
  "esql": "SET unmapped_fields=\\"nullify\\";
TS metrics-kubernetes.state_pod-*
| WHERE @timestamp >= ?from AND @timestamp < ?to
    AND \`kubernetes.pod.uid\` IS NOT NULL
| STATS \`kubernetes.pod.name\` = LAST(\`kubernetes.pod.name\`, @timestamp) WHERE \`kubernetes.pod.name\` IS NOT NULL,
    \`kubernetes.namespace\` = LAST(\`kubernetes.namespace\`, @timestamp) WHERE \`kubernetes.namespace\` IS NOT NULL,
    \`kubernetes.node.name\` = LAST(\`kubernetes.node.name\`, @timestamp) WHERE \`kubernetes.node.name\` IS NOT NULL,
    \`phase\` = LAST(\`kubernetes.pod.status.phase\`, @timestamp) WHERE \`kubernetes.pod.status.phase\` IS NOT NULL,
    \`last_seen\` = MAX(@timestamp)
    BY \`kubernetes.pod.uid\`
| EVAL entity.id = CONCAT(\\"k8s.pod:\\", TO_STRING(kubernetes.pod.uid))
| KEEP \`entity.id\`, \`kubernetes.pod.uid\`, \`kubernetes.pod.name\`, \`kubernetes.namespace\`, \`kubernetes.node.name\`, \`phase\`, \`last_seen\`
| SORT \`last_seen\` DESC NULLS LAST
| LIMIT 10000",
  "params": Array [
