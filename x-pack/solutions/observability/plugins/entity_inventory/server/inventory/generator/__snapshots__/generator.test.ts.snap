exports[`generator k8s.deployment count query 1`] = `
Object {
  "esql": "SET unmapped_fields=\\"nullify\\";
FROM metrics-kubeletstatsreceiver.otel-default, metrics-kubernetes.state_deployment-* METADATA _index
| WHERE @timestamp >= ?from AND @timestamp < ?to
    AND \`kubernetes.namespace\` IS NOT NULL AND \`kubernetes.deployment.name\` IS NOT NULL
    AND (((_index LIKE \\"metrics-kubeletstatsreceiver.otel-default\\" OR _index LIKE \\".ds-metrics-kubeletstatsreceiver.otel-default-*\\") AND (\`k8s.pod.cpu.usage\` IS NOT NULL))
      OR ((_index LIKE \\"metrics-kubernetes.state_deployment-*\\" OR _index LIKE \\".ds-metrics-kubernetes.state_deployment-*-*\\") AND (\`kubernetes.deployment.replicas.desired\` IS NOT NULL OR \`kubernetes.deployment.replicas.available\` IS NOT NULL)))
| STATS BY \`kubernetes.namespace\`, \`kubernetes.deployment.name\`
| STATS \`count\` = COUNT(*)",
  "params": Array [
    Object {
      "from": "2026-09-16T08:30:00.000Z",
    },
    Object {
      "to": "2026-09-16T08:45:00.000Z",
    },
  ],
}
`;

