{
  "type": "plugin",
  "id": "@kbn/groups-plugin",
  "owner": "@elastic/kibana-platform",
  "description": "A manager for Groups - associating Kibana and Elasticsearch assets together",
  "group": "platform",
  "visibility": "shared",
  "plugin": {
    "id": "groups",
    "server": true,
    "browser": true,
    "requiredPlugins": ["features", "security", "spaces"],
    "optionalPlugins": ["embeddable"],
    "requiredBundles": ["kibanaReact"]
  }
}
